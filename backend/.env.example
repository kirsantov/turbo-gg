# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# For development, SQLite is used by default
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ocrinvoice

# Media Storage
MEDIA_ROOT=./media

# OCR Provider Configuration
# Available providers: olmocr, marker_deepseek_r1
OCR_PROVIDER=olmocr

# OlmOCR API Configuration
OLMOCR_API_URL=https://api.olmocr.example.com
OLMOCR_API_KEY=your-olmocr-api-key-here

# Marker API Configuration
MARKER_API_URL=https://api.marker.example.com
MARKER_API_KEY=your-marker-api-key-here

# DeepSeek Configuration
DEEPSEEK_MODEL=r1
